---
import EmptyState from "../components/EmptyState.astro";
import PageHeader from "../components/PageHeader.astro";
import { Badge } from "../components/ui/badge";
import { kaderAlerts } from "../lib/catalog";
import { listAvailability, listFixtures, listPlayers, listRatings, listSquad } from "../lib/directus";
import { getNextMatchday } from "../lib/fixtures";
import Shell from "../layouts/Shell.astro";

const { user, accessToken, supabaseUrl, supabaseAnonKey } = Astro.locals;
const db = { url: supabaseUrl, anonKey: supabaseAnonKey, token: accessToken };
const load = await listFixtures(db);
const matchday = load.ok && load.fixtures.length > 0 ? getNextMatchday(load.fixtures, new Date()) : null;
const spieltag = matchday?.spieltag ?? 1;
const [players, squad, ratings, availability] = await Promise.all([
  listPlayers(db),
  listSquad({ ...db, userId: user.id }),
  listRatings(db),
  listAvailability({ ...db, spieltag }),
]);
const alerts = kaderAlerts(squad, players, availability, ratings, spieltag);
---
<Shell title="Kader-Check" userEmail={user.email}>
  <PageHeader title="Kader-Check" lead="Wer vor der Deadline nicht in die Elf gehört — verletzt, gesperrt oder unsicher." />
  <dl class="grid gap-2 text-sm sm:grid-cols-2">
    <div class="flex items-center gap-2">
      <dt><Badge variant="destructive">Startet nicht</Badge></dt>
      <dd class="text-muted-foreground">Verletzt oder gesperrt — nicht aufstellen.</dd>
    </div>
    <div class="flex items-center gap-2">
      <dt><Badge className="bg-warning/20 text-warning-foreground">Prüfen</Badge></dt>
      <dd class="text-muted-foreground">Fraglich oder wenig Spielzeit zuletzt.</dd>
    </div>
  </dl>
  {squad.length === 0 ? (
    <EmptyState body="Lege zuerst deinen Kader an. Danach prüfen wir Verletzung, Sperre und Spielzeit." href="/kader" cta="Zum Kader" />
  ) : alerts.length === 0 ? (
    <EmptyState title="Alles klar" body="Niemand im Kader ist verletzt, gesperrt oder unsicher." href="/aufstellung" cta="Zur Aufstellung" />
  ) : (
    <div class="space-y-4">
      <ul aria-label="Kader-Warnungen" class="space-y-3">
        {alerts.map((alert) => (
          <li class="flex min-h-11 items-center justify-between gap-3 border-b border-border py-2 text-sm">
            <span>
              {alert.player}
              <span class="mt-0.5 block text-muted-foreground">
                {alert.tone === "block" ? "Nicht aufstellen." : "Vor der Deadline nochmal prüfen."}
              </span>
            </span>
            {alert.tone === "block" ? (
              <Badge variant="destructive">{alert.badge}</Badge>
            ) : (
              <Badge className="bg-warning/20 text-warning-foreground">{alert.badge}</Badge>
            )}
          </li>
        ))}
      </ul>
      <a class="text-link" href="/aufstellung">Zur vorgeschlagenen Aufstellung</a>
    </div>
  )}
</Shell>
