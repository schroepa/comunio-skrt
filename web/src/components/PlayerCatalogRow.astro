---
import { Badge } from "./ui/badge";
import FormBars from "./FormBars.astro";
import type { PlayerRecord } from "../lib/directus";
import { positionChip } from "../lib/radar-view";

type Props = {
  player: PlayerRecord;
  notes?: number[];
  form?: number | null;
  inSquad?: boolean;
  badge?: string;
  detail?: string;
};

const { player, notes = [], form = null, inSquad = false, badge, detail } = Astro.props;
const chip = positionChip(player.position);

const badgeClass: Record<string, string> = {
  Kaufen: "bg-primary/15 text-primary",
  Verkaufen: "bg-destructive/15 text-destructive",
  Halten: "bg-muted text-muted-foreground",
  Beobachten: "bg-warning/20 text-warning-foreground",
  "Nicht verfügbar": "bg-destructive/15 text-destructive",
  "Kein Signal": "bg-muted/50 text-muted-foreground",
};
---
<article class="grid gap-3 border-b border-border/60 py-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
  <div class="flex min-w-0 items-start gap-3">
    <span class:list={["mt-0.5 inline-flex h-7 min-w-9 items-center justify-center rounded px-1 text-[11px] font-semibold", chip.className]}>
      {chip.code}
    </span>
    <div class="min-w-0">
      <p class="truncate font-medium">
        {player.name}
        {inSquad ? <span class="ml-2 text-xs font-normal text-muted-foreground">Kader</span> : null}
      </p>
      <p class="truncate text-sm text-muted-foreground">
        {player.verein} · {player.aktueller_marktwert.toLocaleString("de-DE")} €
      </p>
      {detail ? <p class="mt-1 text-xs text-muted-foreground">{detail}</p> : null}
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-3 sm:justify-end">
    <div class="text-right">
      <p class="text-[11px] text-muted-foreground">Form</p>
      {notes.length === 0 ? (
        <p class="text-sm tabular-nums text-muted-foreground">—</p>
      ) : (
        <div class="flex items-end gap-2">
          <FormBars notes={notes} />
          <span class="text-sm tabular-nums">{form == null ? "—" : Math.round(form)}</span>
        </div>
      )}
    </div>
    {badge ? <Badge className={badgeClass[badge] ?? "bg-muted text-muted-foreground"}>{badge}</Badge> : null}
    <slot />
  </div>
</article>
