---
import EmptyState from "../components/EmptyState.astro";
import PageHeader from "../components/PageHeader.astro";
import PlayerCatalogRow from "../components/PlayerCatalogRow.astro";
import PlayerSearchForm from "../components/PlayerSearchForm.astro";
import { formScore } from "../lib/scores";
import { notesFor } from "../lib/catalog";
import { filterPlayers, hasPlayerFilters, parsePlayerFilters, SEARCH_RESULT_LIMIT, uniqueClubs } from "../lib/players";
import {
  addCompetitor,
  listCompetitors,
  listPlayers,
  listRatings,
  listSquad,
  removeCompetitor,
} from "../lib/directus";
import Shell from "../layouts/Shell.astro";

const { user, accessToken, supabaseUrl, supabaseAnonKey } = Astro.locals;
const db = { url: supabaseUrl, anonKey: supabaseAnonKey, token: accessToken };
const filters = parsePlayerFilters(Astro.url.searchParams);
const rival = Astro.url.searchParams.get("rival") ?? "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  if (action === "add") {
    const names = new Set(
      (await listCompetitors({ ...db, userId: user.id })).map((row) => row.competitor_name),
    );
    const name = String(form.get("competitor_name") ?? "").trim();
    if (name && (names.has(name) || names.size < 3)) {
      await addCompetitor({
        ...db,
        userId: user.id,
        competitorName: name,
        playerId: Number(form.get("player_id")),
      });
    }
  }
  if (action === "remove") {
    await removeCompetitor({ ...db, id: Number(form.get("id")) });
  }
  const nextRival = String(form.get("competitor_name") ?? rival).trim();
  const next = new URL("/konkurrenz", Astro.url);
  if (nextRival) next.searchParams.set("rival", nextRival);
  return Astro.redirect(`${next.pathname}${next.search}`);
}

const [players, squad, ratings, rivals] = await Promise.all([
  listPlayers(db),
  listSquad({ ...db, userId: user.id }),
  listRatings(db),
  listCompetitors({ ...db, userId: user.id }),
]);
const clubs = uniqueClubs(players);
const matched = hasPlayerFilters(filters) ? filterPlayers(players, filters) : [];
const searchHits = matched.slice(0, SEARCH_RESULT_LIMIT);

const byId = new Map(players.map((player) => [player.id, player]));

function meanForm(ids: number[]): string {
  const scores = ids
    .map((id) => formScore(notesFor(id, ratings)))
    .filter((value): value is number => value != null);
  if (scores.length === 0) return "—";
  return String(Math.round(scores.reduce((sum, value) => sum + value, 0) / scores.length));
}

const groups = new Map<string, typeof rivals>();
for (const row of rivals) {
  const list = groups.get(row.competitor_name) ?? [];
  list.push(row);
  groups.set(row.competitor_name, list);
}
---
<Shell title="Konkurrenz" userEmail={user.email}>
  <PageHeader title="Konkurrenz" lead="Form von 2–3 Liga-Rivalen neben deinem Kader. Nicht die anderen App-Nutzer — nur Gegner aus deiner Comunio-Liga." />

  {groups.size === 0 ? (
    <EmptyState title="Noch keine Rivalen" body="Trage unten einen Rivalen-Namen ein, suche Spieler und ordne sie zu." />
  ) : (
    <div class="grid gap-4 md:grid-cols-2">
      <section class="rounded-lg border border-border p-4">
        <h2 class="text-xl font-semibold">Mein Kader</h2>
        <p class="text-sm text-muted-foreground">
          {squad.length} Spieler · Form {meanForm(squad.map((row) => row.player_id))}
        </p>
        {squad.length === 0 ? (
          <p class="mt-2 text-sm text-muted-foreground">
            Noch leer. <a class="text-link" href="/kader">Spieler eintragen</a>
          </p>
        ) : (
          <ul class="mt-2 space-y-1 text-sm">
            {squad.slice(0, 8).map((row) => (
              <li>{byId.get(row.player_id)?.name ?? `Spieler ${row.player_id}`}</li>
            ))}
          </ul>
        )}
        {squad.length > 8 ? (
          <p class="mt-1 text-xs text-muted-foreground">+{squad.length - 8} weitere</p>
        ) : null}
      </section>
      {[...groups.entries()].map(([name, rows]) => (
        <section class="rounded-lg border border-border p-4">
          <h2 class="text-xl font-semibold">{name}</h2>
          <p class="text-sm text-muted-foreground">
            {rows.length} Spieler · Form {meanForm(rows.map((row) => row.player_id))}
          </p>
          <ul class="mt-2 space-y-1 text-sm">
            {rows.map((row) => (
              <li class="flex justify-between gap-2">
                <span>{byId.get(row.player_id)?.name ?? `Spieler ${row.player_id}`}</span>
                <form method="post" onsubmit="return confirm('Spieler von diesem Rivalen entfernen?');">
                  <input type="hidden" name="action" value="remove" />
                  <input type="hidden" name="id" value={row.id} />
                  <input type="hidden" name="competitor_name" value={name} />
                  <button class="min-h-11 text-destructive underline" type="submit">Entfernen</button>
                </form>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  )}

  <section class="space-y-3">
    <h2 class="text-xl font-semibold">Spieler einem Rivalen zuordnen</h2>
    <p class="text-sm text-muted-foreground">Zuerst den Rivalen-Namen eintragen, dann Spieler suchen und zuordnen.</p>
    <PlayerSearchForm filters={filters} clubs={clubs} rival={rival} />
    {!rival.trim() && hasPlayerFilters(filters) ? (
      <p class="text-sm text-muted-foreground" role="status">Rivalen-Namen oben eintragen und erneut filtern, damit du Spieler zuordnen kannst.</p>
    ) : null}
    {hasPlayerFilters(filters) && searchHits.length === 0 ? (
      <p class="text-sm text-muted-foreground">Kein Treffer. Filter lockern.</p>
    ) : null}
    <div>
      {searchHits.map((player) => {
        const notes = notesFor(player.id, ratings);
        return (
          <PlayerCatalogRow player={player} notes={notes} form={formScore(notes)}>
            <form method="post">
              <input type="hidden" name="action" value="add" />
              <input type="hidden" name="competitor_name" value={rival} />
              <input type="hidden" name="player_id" value={player.id} />
              <button
                class="min-h-11 text-link disabled:text-muted-foreground disabled:no-underline"
                type="submit"
                disabled={!rival.trim()}
                title={!rival.trim() ? "Zuerst Rivalen-Namen eintragen und filtern" : undefined}
              >
                {rival.trim() ? `Zu ${rival} hinzufügen` : "Rivalen-Namen fehlt"}
              </button>
            </form>
          </PlayerCatalogRow>
        );
      })}
    </div>
  </section>
</Shell>
