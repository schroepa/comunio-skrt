---
import EmptyState from "../components/EmptyState.astro";
import FilterSheet from "../components/FilterSheet.astro";
import GooeySegment from "../components/GooeySegment";
import PageHeader from "../components/PageHeader.astro";
import PlayerCatalogRow from "../components/PlayerCatalogRow.astro";
import PlayerSearchForm from "../components/PlayerSearchForm.astro";
import { radarRows } from "../lib/catalog";
import { listAvailability, listFixtures, listPlayers, listRatings, listSquad, listValueHistory } from "../lib/directus";
import { getNextMatchday } from "../lib/fixtures";
import { catalogFiltersActive, filterPlayers, hasPlayerFilters, parsePlayerFilters, uniqueClubs } from "../lib/players";
import { parseRadarSort, RADAR_SORTS, sortRadarRows } from "../lib/radar-view";
import Shell from "../layouts/Shell.astro";

const { user, accessToken, supabaseUrl, supabaseAnonKey } = Astro.locals;
const db = { url: supabaseUrl, anonKey: supabaseAnonKey, token: accessToken };
const filters = parsePlayerFilters(Astro.url.searchParams);
const sort = parseRadarSort(Astro.url.searchParams);
const onlySquad = Astro.url.searchParams.get("kader") === "1";

const [load, players, squad, ratings, history] = await Promise.all([
  listFixtures(db),
  listPlayers(db),
  listSquad({ ...db, userId: user.id }),
  listRatings(db),
  listValueHistory(db),
]);
const matchday = load.ok && load.fixtures.length > 0 ? getNextMatchday(load.fixtures, new Date()) : null;
const spieltag = matchday?.spieltag ?? 1;
const availability = await listAvailability({ ...db, spieltag });
const squadIds = new Set(squad.map((row) => row.player_id));
const clubs = uniqueClubs(players);

let catalog = filterPlayers(players, filters);
if (onlySquad) catalog = catalog.filter((player) => squadIds.has(player.id));

const rows = sortRadarRows(
  radarRows(catalog, squadIds, ratings, availability, load.ok ? load.fixtures : [], spieltag, {
    includeHidden: true,
    history,
    marketPlayers: players,
  }),
  sort,
);
---
<Shell title="Spieler-Radar" userEmail={user.email}>
  <PageHeader title="Spieler-Radar" lead="Katalog der Liga: Form gegen Marktwert. Form ist 0–100 aus den letzten Noten." />

  <FilterSheet active={catalogFiltersActive(filters, { onlySquad, sortChanged: sort !== "form" })}>
    <PlayerSearchForm filters={filters} clubs={clubs} action="/radar" resetHref="/radar">
      <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:items-end">
        <fieldset class="space-y-2">
          <legend class="text-sm">Sortierung</legend>
          <GooeySegment
            client:load
            name="sort"
            ariaLabel="Sortierung"
            fill="muted"
            value={sort}
            options={RADAR_SORTS}
          />
        </fieldset>
        <fieldset class="space-y-2">
          <legend class="text-sm">Kader</legend>
          <GooeySegment
            client:load
            name="kader"
            ariaLabel="Kaderfilter"
            fill="muted"
            value={onlySquad ? "1" : ""}
            options={[
              { value: "", label: "Alle Spieler", shortLabel: "Alle" },
              { value: "1", label: "Nur mein Kader", shortLabel: "Kader" },
            ]}
          />
        </fieldset>
      </div>
    </PlayerSearchForm>
  </FilterSheet>

  {rows.length === 0 ? (
    <EmptyState
      body={hasPlayerFilters(filters) || onlySquad ? "Keine Treffer für diese Filter. Filter lockern." : "Noch keine Spielerdaten."}
    />
  ) : (
    <div class="mt-2">
      <p class="mb-2 text-sm text-muted-foreground">{rows.length.toLocaleString("de-DE")} Spieler</p>
      <div>
        {rows.map((row) => (
          <PlayerCatalogRow
            player={row.player}
            notes={row.notes}
            form={row.form}
            inSquad={row.inSquad}
            badge={row.badge}
            detail={`${row.reason}${row.opponents !== "—" ? ` · ${row.opponents}` : ""}`}
          />
        ))}
      </div>
    </div>
  )}
</Shell>
