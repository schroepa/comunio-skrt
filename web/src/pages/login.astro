---
import "../styles/global.css";
import { SUPABASE_ANON_KEY, SUPABASE_URL } from "astro:env/server";
import ThemeBoot from "../components/ThemeBoot.astro";
import ThemeToggle from "../components/ThemeToggle.tsx";
import { ACCESS_COOKIE, REFRESH_COOKIE, loginWithPassword } from "../lib/session";

let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const email = String(form.get("email") ?? "");
  const password = String(form.get("password") ?? "");
  const result = await loginWithPassword({
    url: SUPABASE_URL ?? "",
    anonKey: SUPABASE_ANON_KEY ?? "",
    email,
    password,
  });
  if (result.ok) {
    const secure = Astro.url.protocol === "https:";
    const opts = { httpOnly: true, path: "/", sameSite: "lax" as const, secure };
    Astro.cookies.set(ACCESS_COOKIE, result.tokens.access_token, { ...opts, maxAge: 60 * 60 * 24 * 7 });
    Astro.cookies.set(REFRESH_COOKIE, result.tokens.refresh_token, { ...opts, maxAge: 60 * 60 * 24 * 30 });
    return Astro.redirect("/");
  }
  error =
    result.reason === "invalid_credentials"
      ? "E-Mail oder Passwort stimmt nicht."
      : "Anmeldung gerade nicht möglich. Bitte später erneut versuchen.";
}
---
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Anmelden · Comunio Assistant</title>
    <ThemeBoot />
  </head>
  <body class="min-h-screen bg-app-bg pt-[env(safe-area-inset-top)] font-sans text-foreground antialiased">
    <div class="absolute right-4 top-[max(1rem,env(safe-area-inset-top))]">
      <ThemeToggle client:only="react" />
    </div>
    <main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center px-4">
      <div class="rounded-xl bg-surface p-6 ring-1 ring-foreground/10">
      <p class="text-lg font-semibold tracking-tight">Comunio Assistant</p>
      <h1 class="mt-4 text-3xl font-semibold tracking-tight">Anmelden</h1>
      <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">Nur eingeladene Accounts. Keine Selbst-Registrierung.</p>
      {error ? <p class="mt-4 text-sm text-destructive" role="alert" id="login-error">{error}</p> : null}
      <form method="post" class="mt-6 space-y-4">
        <label class="block text-sm">
          E-Mail
          <input
            class="mt-1 min-h-11 w-full rounded-md border border-border bg-card px-3 py-2"
            type="email"
            name="email"
            required
            autocomplete="username"
            aria-invalid={error ? "true" : undefined}
            aria-describedby={error ? "login-error" : undefined}
          />
        </label>
        <label class="block text-sm">
          Passwort
          <input
            class="mt-1 min-h-11 w-full rounded-md border border-border bg-card px-3 py-2"
            type="password"
            name="password"
            required
            autocomplete="current-password"
            aria-invalid={error ? "true" : undefined}
            aria-describedby={error ? "login-error" : undefined}
          />
        </label>
        <button class="min-h-11 w-full rounded-md bg-primary px-3 py-2 text-sm font-medium text-primary-foreground" type="submit">
          Anmelden
        </button>
      </form>
      </div>
    </main>
  </body>
</html>
