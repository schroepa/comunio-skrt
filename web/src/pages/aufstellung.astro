---
import EmptyState from "../components/EmptyState.astro";
import PageHeader from "../components/PageHeader.astro";
import Pitch from "../components/Pitch.astro";
import { playerPoints } from "../lib/catalog";
import { clubValues } from "../lib/clubs";
import { listAvailability, listFixtures, listPlayers, listRatings, listSquad } from "../lib/directus";
import { getNextMatchday } from "../lib/fixtures";
import { pickLineup, type LineupCandidate } from "../lib/lineup";
import Shell from "../layouts/Shell.astro";

const { user, accessToken, supabaseUrl, supabaseAnonKey } = Astro.locals;
const db = { url: supabaseUrl, anonKey: supabaseAnonKey, token: accessToken };
const load = await listFixtures(db);
const matchday = load.ok && load.fixtures.length > 0 ? getNextMatchday(load.fixtures, new Date()) : null;
const spieltag = matchday?.spieltag ?? 1;
const [players, squad, ratings, availability] = await Promise.all([
  listPlayers(db),
  listSquad({ ...db, userId: user.id }),
  listRatings(db),
  listAvailability({ ...db, spieltag }),
]);
const byId = new Map(players.map((player) => [player.id, player]));
const clubValueMap = clubValues(players);
const candidates: LineupCandidate[] = [];
for (const row of squad) {
  const player = byId.get(row.player_id);
  if (!player) continue;
  if (player.position !== "Torwart" && player.position !== "Abwehr" && player.position !== "Mittelfeld" && player.position !== "Sturm") {
    continue;
  }
  const stats = playerPoints(player, ratings, availability, load.ok ? load.fixtures : [], spieltag, clubValueMap);
  candidates.push({
    id: player.id,
    position: player.position,
    points: stats.points,
    blocked: stats.blocked,
  });
}
const result = pickLineup(candidates);
---
<Shell title="Aufstellung" userEmail={user.email}>
  <div class="flex flex-wrap items-end justify-between gap-3">
    <PageHeader title="Aufstellung" lead="Schätzung, keine Garantie. Übernahme in Comunio bleibt manuell." />
    <form method="get">
      <button class="min-h-11 rounded-md border border-border px-3 py-2 text-sm" type="submit">Aktualisieren</button>
    </form>
  </div>
  {!result.ok && result.reason === "no_goalkeeper" ? (
    <EmptyState body="Kein fitter Torwart im Kader." href="/kader" cta="Zum Kader" />
  ) : !result.ok ? (
    <EmptyState body="Kader ist zu klein für eine Elf." href="/kader" cta="Spieler hinzufügen" />
  ) : (
    <div class="space-y-8">
      <Pitch
        eleven={result.eleven}
        formation={result.formation}
        total={result.total}
        playersById={Object.fromEntries([...byId.entries()].map(([id, player]) => [String(id), player]))}
      />
      <section>
        <h2 class="text-xl font-semibold">Bank</h2>
        {result.bench.length === 0 ? (
          <p class="mt-2 text-sm text-muted-foreground">Keine Reservespieler.</p>
        ) : (
          <ul class="mt-3 divide-y divide-border">
            {result.bench.map((row) => {
              const player = byId.get(row.id);
              return (
                <li class="flex items-center justify-between gap-3 py-2 text-sm">
                  <span>
                    {player?.name ?? `Spieler ${row.id}`}
                    <span class="ml-2 text-muted-foreground">
                      {player?.position}
                      {player?.verein ? ` · ${player.verein}` : ""}
                    </span>
                  </span>
                  <span class="tabular-nums text-muted-foreground">{row.points.toLocaleString("de-DE")}</span>
                </li>
              );
            })}
          </ul>
        )}
      </section>
    </div>
  )}
</Shell>
