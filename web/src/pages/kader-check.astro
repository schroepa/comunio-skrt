---
import { DIRECTUS_URL } from "astro:env/server";
import EmptyState from "../components/EmptyState.astro";
import { Badge } from "../components/ui/badge";
import { kaderAlerts } from "../lib/catalog";
import { listAvailability, listFixtures, listPlayers, listRatings, listSquad } from "../lib/directus";
import { getNextMatchday } from "../lib/fixtures";
import Shell from "../layouts/Shell.astro";

const { user, accessToken } = Astro.locals;
const load = await listFixtures({ url: DIRECTUS_URL, token: accessToken });
const matchday = load.ok && load.fixtures.length > 0 ? getNextMatchday(load.fixtures, new Date()) : null;
const spieltag = matchday?.spieltag ?? 1;
const [players, squad, ratings, availability] = await Promise.all([
  listPlayers({ url: DIRECTUS_URL, token: accessToken }),
  listSquad({ url: DIRECTUS_URL, token: accessToken, userId: user.id }),
  listRatings({ url: DIRECTUS_URL, token: accessToken }),
  listAvailability({ url: DIRECTUS_URL, token: accessToken, spieltag }),
]);
const alerts = kaderAlerts(squad, players, availability, ratings, spieltag);
---
<Shell title="Kader-Check vor Spieltag-Deadline" userEmail={user.email}>
  <h1 class="font-[Syne] text-3xl">Kader-Check vor Spieltag-Deadline</h1>
  <p class="text-sm text-muted-foreground">
    <Badge variant="destructive">Startet nicht</Badge>
    bei Verletzung oder Sperre,
    <Badge className="bg-amber-500/20 text-amber-200">Unsicher, prüfen</Badge>
    / <Badge className="bg-amber-500/20 text-amber-200">Wenig Spielzeit zuletzt</Badge>.
  </p>
  {alerts.length === 0 ? (
    <EmptyState body="Sobald Spieler im Kader und Verfügbarkeit gepflegt sind, erscheinen Warnungen hier." />
  ) : (
    <ul aria-label="Kader-Warnungen" class="mt-4 space-y-3">
      {alerts.map((alert) => (
        <li class="flex items-center justify-between gap-3 border-b border-border py-2 text-sm">
          <span>{alert.player}</span>
          {alert.tone === "block" ? (
            <Badge variant="destructive">{alert.badge}</Badge>
          ) : (
            <Badge className="bg-amber-500/20 text-amber-200">{alert.badge}</Badge>
          )}
        </li>
      ))}
    </ul>
  )}
</Shell>
