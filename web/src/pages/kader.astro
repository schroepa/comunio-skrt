---
import EmptyState from "../components/EmptyState.astro";
import PageHeader from "../components/PageHeader.astro";
import PlayerCatalogRow from "../components/PlayerCatalogRow.astro";
import PlayerSearchForm from "../components/PlayerSearchForm.astro";
import { notesFor } from "../lib/catalog";
import {
  addToSquad,
  getManagerProfile,
  listPlayers,
  listRatings,
  listSquad,
  removeFromSquad,
  saveBudget,
} from "../lib/directus";
import { filterPlayers, hasPlayerFilters, parsePlayerFilters, SEARCH_RESULT_LIMIT, uniqueClubs } from "../lib/players";
import { formScore } from "../lib/scores";
import Shell from "../layouts/Shell.astro";

const { user, accessToken, supabaseUrl, supabaseAnonKey } = Astro.locals;
const db = { url: supabaseUrl, anonKey: supabaseAnonKey, token: accessToken };
const filters = parsePlayerFilters(Astro.url.searchParams);

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  if (action === "add") {
    await addToSquad({
      url: db.url,
      anonKey: db.anonKey,
      token: db.token,
      userId: user.id,
      playerId: Number(form.get("player_id")),
    });
  }
  if (action === "remove") {
    await removeFromSquad({
      url: db.url,
      anonKey: db.anonKey,
      token: db.token,
      membershipId: Number(form.get("membership_id")),
    });
  }
  if (action === "budget") {
    const profile = await getManagerProfile({ ...db, userId: user.id });
    await saveBudget({
      url: db.url,
      anonKey: db.anonKey,
      token: db.token,
      userId: user.id,
      budget: Number(form.get("budget")),
      profileId: profile?.id,
    });
  }
  return Astro.redirect(`${Astro.url.pathname}${Astro.url.search}`);
}

const [squad, players, profile, ratings] = await Promise.all([
  listSquad({ ...db, userId: user.id }),
  listPlayers(db),
  getManagerProfile({ ...db, userId: user.id }),
  listRatings(db),
]);
const clubs = uniqueClubs(players);
const matched = hasPlayerFilters(filters) ? filterPlayers(players, filters) : [];
const searchHits = matched.slice(0, SEARCH_RESULT_LIMIT);
const hiddenHits = matched.length - searchHits.length;

const byId = new Map(players.map((player) => [player.id, player]));
const squadPlayers = squad
  .map((row) => {
    const player = byId.get(row.player_id);
    return player ? { ...player, membershipId: row.id } : null;
  })
  .filter((row) => row !== null);
const inSquad = new Set(squad.map((row) => row.player_id));
const positions = ["Torwart", "Abwehr", "Mittelfeld", "Sturm"] as const;
---
<Shell title="Mein Kader" userEmail={user.email}>
  <PageHeader title="Mein Kader" lead="Spieler eintragen und Budget pflegen — so wie in Comunio." />

  <form method="post" class="flex flex-wrap items-end gap-3">
    <input type="hidden" name="action" value="budget" />
    <label class="text-sm">
      Budget (Comunio)
      <input class="mt-1 block rounded-md border border-border bg-card px-3 py-2" type="number" name="budget" min="0" value={profile?.budget ?? ""} />
    </label>
    <button class="min-h-11 rounded-md bg-secondary px-3 py-2 text-sm" type="submit">Budget speichern</button>
  </form>

  {squadPlayers.length === 0 ? (
    <EmptyState title="Noch leer" body="Suche unten nach Spielern und nimm sie in den Kader." />
  ) : (
    <div class="space-y-6">
      {positions.map((position) => {
        const group = squadPlayers.filter((player) => player.position === position);
        if (group.length === 0) return null;
        return (
          <section>
            <h2 class="text-xl font-semibold">{position}</h2>
            <ul class="mt-2">
              {group.map((player) => {
                const notes = notesFor(player.id, ratings);
                return (
                  <li>
                    <PlayerCatalogRow
                      player={player}
                      notes={notes}
                      form={formScore(notes)}
                      inSquad
                    >
                      <form method="post" onsubmit="return confirm('Diesen Spieler aus dem Kader nehmen?');">
                        <input type="hidden" name="action" value="remove" />
                        <input type="hidden" name="membership_id" value={player.membershipId} />
                        <button class="min-h-11 text-destructive underline" type="submit">Entfernen</button>
                      </form>
                    </PlayerCatalogRow>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })}
    </div>
  )}

  <section class="space-y-3">
    <h2 class="text-xl font-semibold">Spieler suchen</h2>
    <p class="text-sm text-muted-foreground">Name, Position, Verein und Marktwert lassen sich kombinieren.</p>
    <PlayerSearchForm filters={filters} clubs={clubs} />
    {hasPlayerFilters(filters) && searchHits.length === 0 ? (
      <p class="text-sm text-muted-foreground">Kein Treffer. Filter lockern.</p>
    ) : null}
    {hasPlayerFilters(filters) && searchHits.length > 0 ? (
      <p class="text-sm text-muted-foreground">
        {matched.length.toLocaleString("de-DE")} Treffer
        {hiddenHits > 0 ? ` · erste ${SEARCH_RESULT_LIMIT} angezeigt` : ""}
      </p>
    ) : null}
    <div>
      {searchHits.map((player) => {
        const notes = notesFor(player.id, ratings);
        return (
          <PlayerCatalogRow
            player={player}
            notes={notes}
            form={formScore(notes)}
            inSquad={inSquad.has(player.id)}
          >
            <form method="post">
              <input type="hidden" name="action" value="add" />
              <input type="hidden" name="player_id" value={player.id} />
              <button class="min-h-11 text-link disabled:text-muted-foreground disabled:no-underline" type="submit" disabled={inSquad.has(player.id)}>
                {inSquad.has(player.id) ? "Bereits im Kader" : "In den Kader"}
              </button>
            </form>
          </PlayerCatalogRow>
        );
      })}
    </div>
  </section>
</Shell>
