---
import EmptyState from "../components/EmptyState.astro";
import MatchList from "../components/MatchList.astro";
import PageHeader from "../components/PageHeader.astro";
import { Badge } from "../components/ui/badge";
import { Card, CardContent, CardHeader, CardTitle } from "../components/ui/card";
import { kaderAlerts, radarRows } from "../lib/catalog";
import {
  listAvailability,
  listFixtures,
  listPlayers,
  listRatings,
  listSquad,
} from "../lib/directus";
import { getNextMatchday } from "../lib/fixtures";
import Shell from "../layouts/Shell.astro";

const { user, accessToken, supabaseUrl, supabaseAnonKey } = Astro.locals;
const db = { url: supabaseUrl, anonKey: supabaseAnonKey, token: accessToken };
const now = new Date();

const [load, players, squad, ratings] = await Promise.all([
  listFixtures(db),
  listPlayers(db),
  listSquad({ ...db, userId: user.id }),
  listRatings(db),
]);

const scheduleError =
  !load.ok
    ? "Die Spieldaten sind gerade nicht erreichbar. Bitte später erneut laden."
    : load.ok && load.fixtures.length === 0
      ? "Der Spielplan ist noch nicht da. Sobald er synchronisiert ist, erscheinen Spiele und Deadline."
      : null;

const matchday = load.ok && load.fixtures.length > 0 ? getNextMatchday(load.fixtures, now) : null;
const spieltag = matchday?.spieltag ?? 1;
const availability = load.ok ? await listAvailability({ ...db, spieltag }) : [];
const alerts = kaderAlerts(squad, players, availability, ratings, spieltag);
const signals = radarRows(
  players,
  new Set(squad.map((row) => row.player_id)),
  ratings,
  availability,
  load.ok ? load.fixtures : [],
  spieltag,
).filter((row) => row.badge === "Kaufen" || row.badge === "Verkaufen");
---
<Shell title="Übersicht" userEmail={user.email}>
  <PageHeader title="Übersicht" lead="Was vor der Deadline zählt: Warnungen, Transfer-Signale, Spiele. Deadline und Budget stecken im Menü." />

  <div class="grid gap-6 lg:grid-cols-12">
    <div class="order-1 space-y-6 lg:order-2 lg:col-span-5">
      <Card>
        <CardHeader>
          <CardTitle>Posteingang · Kader-Check</CardTitle>
        </CardHeader>
        <CardContent className="space-y-3">
          {squad.length === 0 ? (
            <EmptyState body="Lege zuerst deinen Kader an. Danach erscheinen Warnungen zu Verletzung, Sperre oder wenig Spielzeit." href="/kader" cta="Zum Kader" />
          ) : alerts.length === 0 ? (
            <EmptyState title="Alles klar" body="Niemand im Kader ist verletzt, gesperrt oder unsicher." />
          ) : (
            <ul class="space-y-2">
              {alerts.slice(0, 6).map((alert) => (
                <li class="flex items-center justify-between gap-3 text-sm">
                  <span>
                    {alert.player}
                    <span class="mt-0.5 block text-muted-foreground">{alert.badge}</span>
                  </span>
                  {alert.tone === "block" ? (
                    <Badge variant="destructive">{alert.badge}</Badge>
                  ) : (
                    <Badge className="bg-warning/20 text-warning-foreground">{alert.badge}</Badge>
                  )}
                </li>
              ))}
            </ul>
          )}
          <a class="text-link" href="/kader-check">Zum Kader-Check</a>
        </CardContent>
      </Card>

      <Card>
        <CardHeader>
          <CardTitle>Transfermarkt</CardTitle>
        </CardHeader>
        <CardContent className="space-y-3">
          {signals.length === 0 ? (
            <EmptyState body="Kauf- und Verkaufssignale erscheinen, sobald Noten und Marktwerte da sind." href="/radar" cta="Zum Radar" />
          ) : (
            <>
              <ul class="space-y-2">
                {signals.slice(0, 5).map((row) => (
                  <li class="text-sm">
                    {row.player.name} · {row.badge}
                    <span class="block text-muted-foreground">{row.reason}</span>
                  </li>
                ))}
              </ul>
              <a class="text-link" href="/radar">Zum Radar</a>
            </>
          )}
        </CardContent>
      </Card>
    </div>

    <section class="order-2 min-w-0 lg:order-1 lg:col-span-7">
      {scheduleError ? (
        <div class="space-y-3">
          <h2 class="text-xl font-semibold">Nächste Spiele</h2>
          <EmptyState body={scheduleError} />
        </div>
      ) : matchday ? (
        <MatchList spieltag={matchday.spieltag} fixtures={matchday.fixtures} />
      ) : (
        <EmptyState body="Kein Spieltag in Sicht." />
      )}
    </section>
  </div>
</Shell>
