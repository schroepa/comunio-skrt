---
import { Badge } from "./ui/badge";
import FormBars from "./FormBars.astro";
import RowMenu from "./RowMenu.astro";
import type { PlayerRecord } from "../lib/directus";
import { formatMarketValue } from "../lib/money";
import { positionChip } from "../lib/radar-view";

type Props = {
  player: PlayerRecord;
  notes?: number[];
  form?: number | null;
  inSquad?: boolean;
  badge?: string;
  detail?: string;
};

const { player, notes = [], form = null, inSquad = false, badge, detail } = Astro.props;
const chip = positionChip(player.position);
const hasActions = Astro.slots.has("default");
const hasForm = notes.length > 0;

const badgeClass: Record<string, string> = {
  Kaufen: "bg-primary/15 text-primary",
  Verkaufen: "bg-destructive/15 text-destructive",
  Halten: "bg-muted text-muted-foreground",
  Beobachten: "bg-warning/20 text-warning-foreground",
  "Nicht verfügbar": "bg-destructive/15 text-destructive",
  "Kein Signal": "bg-muted/50 text-muted-foreground",
};
---
<article class="flex min-h-14 items-center gap-2 border-b border-border/60 py-2 sm:gap-3">
  <span class:list={["inline-flex h-7 min-w-9 shrink-0 items-center justify-center rounded px-1 text-[11px] font-semibold", chip.className]}>
    {chip.code}
  </span>
  <div class="min-w-0 flex-1">
    <p class="truncate font-medium leading-tight">
      {player.name}
      {inSquad ? <span class="ml-1.5 text-xs font-normal text-muted-foreground">Kader</span> : null}
    </p>
    <p class="truncate text-sm text-muted-foreground">{player.verein}</p>
    {detail ? <p class="mt-0.5 truncate text-xs text-muted-foreground">{detail}</p> : null}
  </div>
  <div class="flex shrink-0 items-center gap-2 sm:gap-3">
    <p class="tabular-nums text-sm font-medium whitespace-nowrap">{formatMarketValue(player.aktueller_marktwert)}</p>
    {
      hasForm ? (
        <div class="flex items-end gap-1" title={form == null ? "Form" : `Form ${Math.round(form)}`}>
          <div class="hidden sm:block">
            <FormBars notes={notes} />
          </div>
          <span class="text-sm tabular-nums">{form == null ? "—" : Math.round(form)}</span>
        </div>
      ) : null
    }
    {badge ? <Badge className={badgeClass[badge] ?? "bg-muted text-muted-foreground"}>{badge}</Badge> : null}
    {
      hasActions ? (
        <RowMenu>
          <slot />
        </RowMenu>
      ) : null
    }
  </div>
</article>
